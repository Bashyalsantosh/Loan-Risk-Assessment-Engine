apiVersion: v1
kind: Service
metadata:
  name: {{ include "loan-risk-engine.fullname" . }}-api
  labels:
    {{- include "loan-risk-engine.labels" . | nindent 4 }}
spec:
  type: {{ .Values.service.type }}
  ports:
    - port: {{ .Values.service.port }}
      targetPort: {{ .Values.service.targetPort }}
      protocol: TCP
      name: http
  selector:
    {{- include "loan-risk-engine.selectorLabels" . | nindent 4 }}
    app.kubernetes.io/component: api
