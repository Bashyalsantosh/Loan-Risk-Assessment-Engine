vrrp_script check_haproxy {
    script "/usr/bin/killall -0 haproxy"
    interval 2
    weight 2
}

vrrp_instance VI_1 {
    state BACKUP
    interface eth0
    virtual_router_id 51
    priority 100
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass VrrpSecretKey123!
    }

    virtual_ipaddress {
        10.0.1.100/24 dev eth0
    }

    track_script {
        check_haproxy
    }
}
