CREATE SCHEMA IF NOT EXISTS audit;

-- 1. Create Partitioned Master Table
CREATE TABLE audit.data_changes (
    audit_id BIGINT GENERATED ALWAYS AS IDENTITY,
    event_time TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    table_schema TEXT NOT NULL,
    table_name TEXT NOT NULL,
    operation VARCHAR(10) NOT NULL,
    session_user_name TEXT NOT NULL DEFAULT SESSION_USER,
    client_ip INET DEFAULT inet_client_addr(),
    old_data JSONB,
    new_data JSONB,
    changed_fields JSONB,
    PRIMARY KEY (event_time, audit_id)
) PARTITION BY RANGE (event_time);

-- Composite Index on Partitioned Master (Inherited by all child partitions)
CREATE INDEX idx_data_changes_lookup 
    ON audit.data_changes (table_schema, table_name, event_time DESC);

-- 2. Manually Pre-create Initial Monthly Partitions (Example: Q3/Q4 2026)
CREATE TABLE audit.data_changes_y2026m09 PARTITION OF audit.data_changes
    FOR VALUES FROM ('2026-09-01 00:00:00+00') TO ('2026-10-01 00:00:00+00');

CREATE TABLE audit.data_changes_y2026m10 PARTITION OF audit.data_changes
    FOR VALUES FROM ('2026-10-01 00:00:00+00') TO ('2026-11-01 00:00:00+00');

CREATE TABLE audit.data_changes_y2026m11 PARTITION OF audit.data_changes
    FOR VALUES FROM ('2026-11-01 00:00:00+00') TO ('2026-12-01 00:00:00+00');

-- 3. Default Partition (Safety catch for out-of-range timestamps)
CREATE TABLE audit.data_changes_default PARTITION OF audit.data_changes DEFAULT;
